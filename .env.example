# Wallet private key (with or without 0x prefix)
PRIVATE_KEY=your_private_key_here

# 0G Compute Router API key (if required)
ZG_API_KEY=your_0g_api_key_here

# 0G Network RPCs
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai

# Deployed contract address (fill after running: npm run deploy)
ORACLE_CONTRACT_ADDRESS=
# Token ID to record resolutions against (default: 1, minted during deploy)
ORACLE_TOKEN_ID=1
